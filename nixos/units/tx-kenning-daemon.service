[Unit]
Description=TianxiaOS Artificial Kenning Daemon (AK-Zip, AK-Bridge, AK-Shield)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/var/lib/tianxia/bin/tx_kenning_daemon --daemon
Restart=always
RestartSec=3s
MemoryMax=256M
TasksMax=128
ProtectSystem=strict
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
