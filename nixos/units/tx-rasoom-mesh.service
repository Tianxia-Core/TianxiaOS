[Unit]
Description=TianxiaOS RASOOM-NKG Semiotic Graph & Konnakol TDMA Mesh Daemon
After=network.target

[Service]
Type=simple
ExecStart=/var/lib/tianxia/bin/tx_rasoom_nkg --daemon
Restart=always
RestartSec=3s
MemoryMax=256M
TasksMax=128
ProtectSystem=strict
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
