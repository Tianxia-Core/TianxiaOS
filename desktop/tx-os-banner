HOST_STR="${HOSTNAME:-$(uname -n 2>/dev/null || printf 'latitude-tianxia')}"
KERNEL_STR="$(uname -sr 2>/dev/null || printf 'Linux')"
UPTIME_STR="$(uptime -p 2>/dev/null || printf 'up active')"
UPTIME_STR="${UPTIME_STR#up }"

CPU_STR="x86_64 Sovereign Node"
if [ -r /proc/cpuinfo ]; then
    while IFS=':' read -r k v; do
        case "${k}" in
            "model name"*)
                CPU_STR="${v# }"
                CPU_STR="${CPU_STR//(R)/}"
                CPU_STR="${CPU_STR//(TM)/}"
                CPU_STR="${CPU_STR%% @*}"
                break
                ;;
        esac
    done < /proc/cpuinfo
fi

MEM_STR="Active"
if [ -r /proc/meminfo ]; then
    MEM_TOTAL_KB=0
    MEM_AVAIL_KB=0
    while read -r mk mv _; do
        case "${mk}" in
            MemTotal:) MEM_TOTAL_KB="${mv}" ;;
            MemAvailable:) MEM_AVAIL_KB="${mv}" ;;
        esac
    done < /proc/meminfo
    if [ "${MEM_TOTAL_KB}" -gt 0 ] 2>/dev/null; then
        MEM_USED_MB=$(( (MEM_TOTAL_KB - MEM_AVAIL_KB) / 1024 ))
        MEM_TOT_MB=$(( MEM_TOTAL_KB / 1024 ))
        MEM_STR="${MEM_USED_MB} MiB / ${MEM_TOT_MB} MiB"
    fi
fi

