# ffp: FFP-MURUA-SERVICE systemd declarative
[Unit]
Description=TianxiaOS Murua Universal Tracer & Sovereign Actuation Daemon (v8.4-OMEGA)
After=network.target network-online.target wireguard.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/tianxia/murua
ExecStart=/var/lib/tianxia/murua/bin/tx_murua_tracer_daemon both --daemon
Restart=always
RestartSec=5s

# DSS-14 Pillar 5 (Bhairavī) Resource Bounding & Capability Hardening
MemoryMax=512M
TasksMax=64
CPUQuota=100%
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/tianxia/murua /run/tianxia
PrivateTmp=true
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE

# Environment
Environment=RUST_BACKTRACE=1
Environment=MURUA_NODE_IP=10.77.0.3
Environment=MURUA_MESH_INTERFACE=wg0

[Install]
WantedBy=multi-user.target
