[Unit]
Description=TianxiaOS Oracular Engine & ARSI Anti-Reasonwashing Verifier
After=network.target

[Service]
Type=simple
ExecStart=/var/lib/tianxia/bin/tx_oracular_arsi --daemon
Restart=always
RestartSec=3s
MemoryMax=256M
TasksMax=128
ProtectSystem=strict
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
